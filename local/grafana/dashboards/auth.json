{
  "uid": "auth", "title": "Card Auth Engine", "schemaVersion": 39, "refresh": "5s", "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Authorisation latency p99 by strategy (ms)", "gridPos": {"x":0,"y":0,"w":12,"h":9},
     "fieldConfig": {"defaults": {"unit": "ms"}},
     "targets": [{"datasource":{"type":"prometheus","uid":"prom"},"expr":"histogram_quantile(0.99, sum by (le, strategy) (rate(auth_latency_seconds_bucket[30s]))) * 1000","legendFormat":"{{strategy}}"}]},
    {"id": 2, "type": "timeseries", "title": "Authorisations per second by strategy + decision", "gridPos": {"x":12,"y":0,"w":12,"h":9},
     "targets": [{"datasource":{"type":"prometheus","uid":"prom"},"expr":"sum by (strategy, decision) (rate(auth_latency_seconds_count[30s]))","legendFormat":"{{strategy}} {{decision}}"}]},
    {"id": 3, "type": "timeseries", "title": "Mean latency by strategy (ms)", "gridPos": {"x":0,"y":9,"w":12,"h":8},
     "fieldConfig": {"defaults": {"unit": "ms"}},
     "targets": [{"datasource":{"type":"prometheus","uid":"prom"},"expr":"sum by (strategy) (rate(auth_latency_seconds_sum[30s])) / sum by (strategy) (rate(auth_latency_seconds_count[30s])) * 1000","legendFormat":"{{strategy}}"}]},
    {"id": 4, "type": "timeseries", "title": "Requests by instance (both auth instances serve traffic)", "gridPos": {"x":12,"y":9,"w":12,"h":8},
     "targets": [{"datasource":{"type":"prometheus","uid":"prom"},"expr":"sum by (instance) (rate(http_server_requests_seconds_count{uri=\"/authorizations\"}[30s]))","legendFormat":"{{instance}}"}]}
  ]
}
